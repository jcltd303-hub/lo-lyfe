# Public Supabase settings for a reviewed catalog and Auth.
# The project URL and publishable key may be exposed to the browser. Never use a secret/service key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Required for the delete-my-account endpoint; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
